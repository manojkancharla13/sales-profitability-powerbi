model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customer","Date","Product","Territory","Sales","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customer
ref table Date
ref table Product
ref table Territory
ref table Sales
ref table _Measures

ref cultureInfo en-IN

