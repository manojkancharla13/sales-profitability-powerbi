table _Measures
	lineageTag: 48e6cf8f-360c-48e2-ace7-0ad0087709d2

	measure 'Total Sales' = SUM ( Sales[SalesAmount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1 Base
		lineageTag: 1aeef11a-d29b-462f-a8d8-500b81818ec0

	measure 'Total Cost' = SUM ( Sales[TotalProductCost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Base
		lineageTag: 518f8eab-252d-4a0c-9341-f680c096e1f3

	measure 'Gross Profit' = SUMX ( Sales, Sales[SalesAmount] - Sales[TotalProductCost] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1 Base
		lineageTag: 309a9352-6359-4885-a5a4-ac6bef276627

	measure 'Profit Margin %' = DIVIDE ( [Gross Profit], [Total Sales] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 1 Base
		lineageTag: 8a6e95ff-66da-400b-87bd-5dc5d5f83e1d

	measure 'Order Count' = DISTINCTCOUNT ( Sales[SalesOrderNumber] )
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: f32948a9-a1dc-4ad3-96fa-644d65440061

	measure 'Units Sold' = SUM ( Sales[Quantity] )
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: af082a2e-2b38-45eb-b9b1-be24d9ee2db5

	measure 'Customer Count' = DISTINCTCOUNT ( Sales[CustomerKey] )
		formatString: #,0
		displayFolder: 5 Customers
		lineageTag: 775761a0-de11-4a5f-b2e7-0216bd99850f

	measure 'Avg Order Value' = DIVIDE ( [Total Sales], [Order Count] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1 Base
		lineageTag: 5a8be587-f768-49d7-8b7e-9d359f11c9e7

	measure 'Sales LY' =
			
			CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: 83bfa866-a9b3-429a-be75-0a5582f49394

	measure 'YoY Growth %' =
			
			DIVIDE ( [Total Sales] - [Sales LY], [Sales LY] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 2 Time Intelligence
		lineageTag: 97048e84-469c-4726-8930-3aa2a839b656

	measure 'Sales YTD' = TOTALYTD ( [Total Sales], 'Date'[Date] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: f2eaa89f-d804-42df-be41-080566b2fd5b

	measure 'Sales QTD' = TOTALQTD ( [Total Sales], 'Date'[Date] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: 3d76038c-9a76-459f-aaaa-7d7c7a258d08

	measure 'Sales MTD' = TOTALMTD ( [Total Sales], 'Date'[Date] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: 7a08465e-d6ab-40f7-9e00-0ca1b97b0e97

	measure 'Running Total' =
			
			CALCULATE (
			    [Total Sales],
			    FILTER ( ALL ( 'Date'[Date] ), 'Date'[Date] <= MAX ( 'Date'[Date] ) )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: ba63d992-f86b-43ef-a35b-a4e7ba938b90

	measure 'Sales % of Total' =
			DIVIDE (
			    [Total Sales],
			    CALCULATE ( [Total Sales], ALLSELECTED ( Product ) )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3 Contribution
		lineageTag: e17cfeac-d2ce-4eab-af23-ec09c78d2b9d

	measure 'Bikes Sales' = CALCULATE ( [Total Sales], Product[Category] = "Bikes" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 3 Contribution
		lineageTag: f96ab163-7897-4a73-978f-495a2896e09f

	measure 'Bikes Share %' = DIVIDE ( [Bikes Sales], CALCULATE ( [Total Sales], ALL ( Product ) ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3 Contribution
		lineageTag: 7957e774-41f8-4770-9a89-613ac451ed31

	measure 'Profit LY' = CALCULATE ( [Gross Profit], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: 4f57a441-8ecf-4c8f-b10a-0b5e18f01d91

	measure 'Profit YoY %' = DIVIDE ( [Gross Profit] - [Profit LY], [Profit LY] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 2 Time Intelligence
		lineageTag: 9ab8179e-f411-436a-8ba4-37798840f128

	measure 'Sales YoY Change' = IF ( NOT ISBLANK ( [Sales LY] ), [Total Sales] - [Sales LY] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: 8b196336-0087-43d8-9488-72ecaf889c23

	measure 'Margin Change (pp)' =
			VAR MarginLY = DIVIDE ( [Profit LY], [Sales LY] )
			RETURN
			    IF ( NOT ISBLANK ( MarginLY ), [Profit Margin %] - MarginLY )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 2 Time Intelligence
		lineageTag: 90731772-906b-41e6-8d94-a575fb39b43f

	measure 'Product Rank' =
			IF (
			    ISINSCOPE ( Product[ProductName] ),
			    RANKX ( ALLSELECTED ( Product[ProductName] ), [Total Sales], , DESC, DENSE )
			)
		formatString: 0
		displayFolder: 4 Ranking
		lineageTag: 3358c23b-a280-4bd2-89f1-f5d7d4d5164e

	measure 'Top N Sales' =
			VAR N = [Top N Value]
			RETURN
			    IF ( [Product Rank] <= N, [Total Sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 4 Ranking
		lineageTag: 04abf249-2289-4edb-b082-18fc81fa6108

	measure 'New Customers' =
			VAR PeriodStart = MIN ( 'Date'[Date] )
			VAR PeriodEnd = MAX ( 'Date'[Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( Sales[CustomerKey] ),
			        FILTER (
			            VALUES ( Customer[FirstPurchaseDate] ),
			            Customer[FirstPurchaseDate] >= PeriodStart
			                && Customer[FirstPurchaseDate] <= PeriodEnd
			        )
			    )
		formatString: #,0
		displayFolder: 5 Customers
		lineageTag: ca2bfb4d-3414-4a35-8c09-dab4ab4c4c66

	measure 'Returning Customers' = [Customer Count] - [New Customers]
		formatString: #,0
		displayFolder: 5 Customers
		lineageTag: 850b1e74-71ed-4247-aec2-c4a207db15d9

	measure 'Orders per Customer' = DIVIDE ( [Order Count], [Customer Count] )
		formatString: 0.00
		displayFolder: 5 Customers
		lineageTag: c97ee617-ccfb-4c15-84e7-72bb31971069

	measure 'Avg Selling Price' = DIVIDE ( [Total Sales], [Units Sold] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1 Base
		lineageTag: 1711f3fc-90a6-455c-83cb-0b7716c52168

	measure 'Bike Accessory Attach %' =
			VAR BikeOrders =
			    CALCULATETABLE ( VALUES ( Sales[SalesOrderNumber] ), Product[Category] = "Bikes" )
			VAR AccessoryOrders =
			    CALCULATETABLE ( VALUES ( Sales[SalesOrderNumber] ), Product[Category] = "Accessories" )
			RETURN
			    DIVIDE ( COUNTROWS ( INTERSECT ( BikeOrders, AccessoryOrders ) ), COUNTROWS ( BikeOrders ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3 Contribution
		lineageTag: 7fd3e689-4ded-4e2f-b5d5-1dddff70ce9f

	measure 'Drillthrough Title' = "Product detail: " & SELECTEDVALUE ( Product[ProductName], "select one product" )
		displayFolder: 6 Labels
		lineageTag: 35ff9566-c22d-4cb7-a0f7-06e93f1b7b78

	measure 'Report Title Period' =
			VAR y = SELECTEDVALUE ( 'Date'[Year] )
			RETURN IF ( ISBLANK ( y ), "All years (Dec 2010 - Jan 2014)", "Year " & y )
		displayFolder: 6 Labels
		lineageTag: ad5f31e3-de61-4e92-9430-238db2f445c8

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

